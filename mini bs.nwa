  {"Brock",    3800, 1620, 280, 2000, 360, 1,  0, ATK_LOB,    SUP_MEGASHOT, GAD_SPEED, STAR_DMG, 100, 0xC93B3B, 0x8A2222, 2},
  {"Dynamike",4000, 1330, 230, 1800, 280, 2, 12, ATK_LOB,     SUP_BARRAGE,  GAD_BLAST, STAR_DMG, 100, 0xE0B03B, 0xA07822, 3},
